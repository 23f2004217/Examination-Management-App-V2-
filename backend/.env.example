# Copy this file to .env and fill it in. .env is git-ignored and is NOT part of the submission.
# Gmail sending (git-ignored). The app password is Google's 16-letter code, without spaces.
MAIL_HOST=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
# The admin's monthly report is mailed here (the admin LOGIN stays admin@gmail.com).
ADMIN_NOTIFY_EMAIL=
